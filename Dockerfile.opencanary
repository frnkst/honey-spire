FROM python:3.12-slim

# Pin the Opencanary version; its JSON log schema feeds the tower's signal
# parser, so upgrades go together with src/lib/signals.ts.
RUN pip install --no-cache-dir opencanary==0.9.4

# NTP listens below 1024, so the container keeps NET_BIND_SERVICE only.
RUN apt-get update -qq && apt-get install -y -qq --no-install-recommends \
      libcap2-bin \
    && rm -rf /var/lib/apt/lists/* \
    && setcap cap_net_bind_service=+ep "$(readlink -f "$(command -v python3)")"

# The dashboard (uid 999) and the sensor shipper tail the JSON log from this
# image's named volume read-only; named-volume initialization copies the
# image directory's ownership AND mode, so /data must stay world-readable —
# useradd's --create-home would otherwise create it 0700 (Debian HOME_MODE).
RUN useradd --system --uid 900 --home-dir /data --create-home opencanary \
    && chmod 0755 /data
USER 900
WORKDIR /data

# opencanaryd is a bash wrapper written for root containers with sudo: as uid
# 900 its `sudo` shim falls through to `$(which sudo) $*`, and with no sudo in
# the image `sudo -E twistd ...` becomes `-E twistd ...` -> exec failure. Its
# housekeeping (touch /var/tmp/opencanary.log, chown /etc/opencanaryd) also
# fights the read-only container. Skip the wrapper and run twistd on the .tac
# directly; the config is read from /etc/opencanaryd/opencanary.conf by
# default, which is where compose mounts it.
ENTRYPOINT ["twistd", "-noy", "/usr/local/bin/opencanary.tac", "--pidfile", "/tmp/opencanaryd.pid"]
