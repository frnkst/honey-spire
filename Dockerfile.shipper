FROM golang:1.24-alpine AS build
ARG VERSION=dev
WORKDIR /src
COPY go.mod go.sum ./
COPY cmd/shipper ./cmd/shipper
RUN CGO_ENABLED=0 go build -trimpath \
    -ldflags="-s -w -X main.version=${VERSION}" \
    -o /shipper ./cmd/shipper

FROM alpine:3.22
# uid 999 matches the cowrie container's user on the shared cowrie-data
# volume; the pre-created chowned state dir makes the fresh named volume
# writable (named-volume initialization copies image ownership).
# The account's primary group takes the first free gid instead of 999,
# which alpine 3.22's base layout already reserves for the "ping" group;
# the numeric chown and USER below are what the runtime relies on.
RUN addgroup -S shipper \
    && adduser -S -D -u 999 -G shipper shipper \
    && mkdir -p /data/shipper \
    && chown 999:999 /data/shipper
COPY --from=build /shipper /usr/local/bin/shipper
USER 999:999
ENTRYPOINT ["/usr/local/bin/shipper"]
