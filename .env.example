SITE_ADDRESS=honeypot.example.com
HONEY_SPIRE_IMAGE=ghcr.io/frnkst/honey-spire:latest
# Install topology: full (dashboard + honeypot) or tower (dashboard only).
HONEY_SPIRE_MODE=full
ADMIN_USERNAME=admin
ADMIN_PASSWORD_HASH=
SESSION_SECRET=
SECURE_COOKIES=true
MAXMIND_ACCOUNT_ID=
MAXMIND_LICENSE_KEY=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_HOURLY_INTERVAL_MINUTES=60
TELEGRAM_DAILY_INTERVAL_HOURS=24
RETENTION_DAYS=90
RAW_SESSION_RETENTION_DAYS=7

# Beecon-only installs use these instead (see compose.beecon.yaml):
# HONEY_SPIRE_SHIPPER_IMAGE=ghcr.io/frnkst/honey-spire-shipper:latest
# TOWER_URL=https://tower.example.com
# BEECON_TOKEN=
# BEECON_NAME=
