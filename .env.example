SITE_ADDRESS=honeypot.example.com
NEON_HIVE_IMAGE=ghcr.io/frnkst/neonhive:latest
# Install topology: full (dashboard + honeypot) or hive (dashboard only).
NEON_HIVE_MODE=full
ADMIN_USERNAME=admin
ADMIN_PASSWORD_HASH=
SESSION_SECRET=
SECURE_COOKIES=true
MAXMIND_ACCOUNT_ID=
MAXMIND_LICENSE_KEY=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_HOURLY_INTERVAL_MINUTES=60
TELEGRAM_DAILY_INTERVAL_HOURS=24
RETENTION_DAYS=90
RAW_SESSION_RETENTION_DAYS=7

# Recon sensors (nmap scan detection, decoy ports, Opencanary service
# honeypots). Leave COMPOSE_PROFILES empty to disable the extra containers.
# COMPOSE_PROFILES=recon
# OPENCANARY_IMAGE=ghcr.io/frnkst/neonhive-opencanary:latest
# OPENCANARY_JSON_LOG=/data/opencanary/opencanary.json
# SENSOR_EVENTS_LOG=/data/sensor/events.json
# SENSOR_RECON=on
# DECOY_PORTS=5432,9200,2375,27017
# RECON_EXCLUDE_PORTS=22,80,443,3001,8080,21,23,123,1433,3306,3389,5900,6379,9418

# Sensor-only installs use these instead (see compose.sensor.yaml):
# NEON_HIVE_SHIPPER_IMAGE=ghcr.io/frnkst/neonhive-shipper:latest
# HIVE_URL=https://hive.example.com
# SENSOR_TOKEN=
# SENSOR_NAME=
